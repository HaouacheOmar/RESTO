# Read from the environment by config/settings.py (defaults match docker-compose.yml)
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Production (DEBUG=0): SECRET_KEY is required; add the public origin, e.g. https://resto.example.com
CSRF_TRUSTED_ORIGINS=
# Django admin (0 where the manager password is public, e.g. a demo)
ADMIN_ENABLED=1
# Proxies in front of Django, for per-IP rate limits (production: 2 = Vercel + Render)
NUM_PROXIES=0
# Optional error tracking
SENTRY_DSN=
# Email (password reset). Without EMAIL_HOST, emails are printed to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RESTO <no-reply@resto.local>
FRONTEND_URL=http://localhost:8088
TIME_ZONE=Africa/Algiers
POSTGRES_DB=resto
POSTGRES_USER=resto
POSTGRES_PASSWORD=resto
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
REDIS_URL=redis://localhost:6380/0
REDIS_DB=0
# Supabase Postgres: use the session pooler (IPv4) and POSTGRES_SSLMODE=require
POSTGRES_SSLMODE=prefer
# Photos in Supabase Storage (S3 protocol); leave S3_BUCKET empty to keep them in media/
S3_BUCKET=
S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_DOMAIN=<project-ref>.supabase.co/storage/v1/object/public/<bucket>
