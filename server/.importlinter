# Module boundaries of the monolith, checked in CI (`lint-imports`).
# A module may use another one only through its `api.py`; views, serializers, models and helpers stay private.
# `config` is the wiring (settings, URLs, ASGI) and may import anything; tests may too.

[importlinter]
root_packages =
    accounts
    catalog
    inventory
    service
    analytics
    realtime
    monitoring
    config

[importlinter:contract:accounts-api]
name = The other modules use accounts only through accounts.api
type = forbidden
source_modules =
    catalog
    inventory
    service
    analytics
    realtime
    monitoring
forbidden_modules =
    accounts
ignore_imports =
    ** -> accounts.api
    *.tests -> accounts.**
allow_indirect_imports = True
unmatched_ignore_imports_alerting = none

[importlinter:contract:catalog-api]
name = The other modules use catalog only through catalog.api
type = forbidden
source_modules =
    accounts
    inventory
    service
    analytics
    realtime
    monitoring
forbidden_modules =
