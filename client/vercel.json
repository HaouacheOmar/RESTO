{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://resto-api.onrender.com/api/:path*" },
    { "source": "/admin/:path*", "destination": "https://resto-api.onrender.com/admin/:path*" },
    { "source": "/static/:path*", "destination": "https://resto-api.onrender.com/static/:path*" },
    { "source": "/media/:path*", "destination": "https://resto-api.onrender.com/media/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
