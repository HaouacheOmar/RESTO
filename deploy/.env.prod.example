# Production settings. On the server: cp deploy/.env.prod.example .env, then fill in every value.
# docker-compose.prod.yml refuses to start while a required one is missing.
# Long random values: python -c "import secrets; print(secrets.token_urlsafe(48))"

# The public address (its DNS must point to this server)
DOMAIN=resto.example.dz

# Required secrets
SECRET_KEY=
POSTGRES_PASSWORD=
MONITORING_STREAM_SECRET=

# Email for "mot de passe oublié" (SMTP: Brevo, the host's SMTP...). Without EMAIL_HOST, no email is sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RESTO <no-reply@resto.example.dz>

# Optional
SENTRY_DSN=
ADMIN_ENABLED=1
TIME_ZONE=Africa/Algiers
KEEP_DAYS=14
