# HTTPS in front of the whole app. Caddy gets and renews the Let's Encrypt certificate by itself:
# the domain must point to this server, and ports 80 and 443 must be open.
{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy web:80 {
		flush_interval -1 # camera streams (MJPEG): send each image at once
	}
}
